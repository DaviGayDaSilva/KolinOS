# KolinOS own APT repository (Phase 9 — disabled until published).
# Enable with:
#   sudo mv /etc/apt/sources.list.d/kolinos.sources.disabled \
#           /etc/apt/sources.list.d/kolinos.sources
Types: deb
URIs: @KOLIN_APT_REPO_URL@
Suites: @KOLIN_CODENAME_LOWER@
Components: main
Architectures: @KOLIN_DEB_ARCH@
Signed-By: /etc/apt/trusted.gpg.d/kolinos.gpg
