# KolinOS "Corvo Glass" — tint2 panel (FASE 7)
# Install path: /etc/xdg/tint2/kolinos.tint2rc
#
# NOTE on the format: tint2 17 takes its backgrounds as anonymous consecutive
# blocks — each block starts with 'rounded =' and consumes the lines after it.
# There is no 'background_id =' key (tint2 rejects it). Block order matters:
# 1=panel, 2=task, 3=task active, 4=urgent, 5=tooltip.
# Transparency needs a compositor (picom); with it the panel is frosted glass.

#-------------------------------------
# Backgrounds
#-------------------------------------
# Background 1: panel (glass slab)
rounded = 14
border_width = 1
border_sides = TBLR
background_color = #14102a 62
border_color = #ffffff 22
background_color_hover = #14102a 68
border_color_hover = #ffffff 30
background_color_pressed = #14102a 72
border_color_pressed = #ffffff 30

# Background 2: task / iconified task
rounded = 10
border_width = 1
border_sides = TBLR
background_color = #ffffff 0
border_color = #ffffff 0
background_color_hover = #ffffff 26
border_color_hover = #ffffff 22
background_color_pressed = #ffffff 14
border_color_pressed = #ffffff 18

# Background 3: active task (brand purple)
rounded = 10
border_width = 1
border_sides = TBLR
background_color = #785ac8 200
border_color = #a88bff 160
background_color_hover = #8a6ad8 210
border_color_hover = #a88bff 200
background_color_pressed = #6a4cb8 220
border_color_pressed = #a88bff 200

# Background 4: urgent task
rounded = 10
border_width = 1
border_sides = TBLR
background_color = #fb7185 210
border_color = #fb7185 255
background_color_hover = #fb7185 230
border_color_hover = #ffffff 200
background_color_pressed = #c7455f 230
border_color_pressed = #ffffff 180

# Background 5: tooltip
rounded = 12
border_width = 1
border_sides = TBLR
background_color = #14102a 235
border_color = #ffffff 40
background_color_hover = #14102a 235
border_color_hover = #ffffff 40
background_color_pressed = #14102a 235
border_color_pressed = #ffffff 40

#-------------------------------------
# Panel
panel_items = LTSC
panel_size = 100% 46
panel_margin = 8 8
panel_padding = 10 4 10
panel_background_id = 1
wm_menu = 1
panel_dock = 0
panel_position = top center horizontal
panel_layer = top
panel_monitor = all
panel_shrink = 0
autohide = 0
autohide_show_timeout = 0
autohide_hide_timeout = 0.5
autohide_height = 2
strut_policy = follow_size
panel_window_name = tint2
disable_transparency = 0
mouse_effects = 1
font_shadow = 0
mouse_hover_icon_asb = 100 0 14
mouse_pressed_icon_asb = 100 0 0

#-------------------------------------
# Taskbar
taskbar_mode = multi_desktop
taskbar_hide_if_empty = 0
taskbar_padding = 6 2 6
taskbar_background_id = 0
taskbar_active_background_id = 0
taskbar_name = 0
taskbar_hide_inactive_tasks = 0
taskbar_hide_different_monitor = 0
taskbar_hide_different_desktop = 0
taskbar_always_show_all_desktop_tasks = 0
taskbar_name_padding = 4 2
taskbar_name_background_id = 0
taskbar_name_active_background_id = 0
taskbar_name_font_color = #a9a3c9 100
taskbar_name_active_font_color = #f5f3ff 100
taskbar_distribute_size = 0
taskbar_sort_order = none
task_align = left

#-------------------------------------
# Task
task_text = 1
task_icon = 1
task_centered = 1
urgent_nb_of_blink = 100000
task_maximum_size = 220 40
task_padding = 6 2 8
task_tooltip = 1
task_thumbnail = 0
task_thumbnail_size = 210
task_font = Inter 10
task_font_color = #f5f3ff 90
task_active_font_color = #f5f3ff 100
task_iconified_font_color = #a9a3c9 75
task_background_id = 2
task_active_background_id = 3
task_urgent_background_id = 4
task_iconified_background_id = 2
mouse_left = toggle_iconify
mouse_middle = none
mouse_right = close
mouse_scroll_up = toggle
mouse_scroll_down = iconify

#-------------------------------------
# System tray (notification area)
systray_padding = 6 2 6
systray_background_id = 0
systray_sort = ascending
systray_icon_size = 22
systray_icon_asb = 100 0 0
systray_monitor = 1
systray_name_filter =

#-------------------------------------
# Launcher
launcher_padding = 6 2 6
launcher_background_id = 0
launcher_icon_background_id = 0
launcher_icon_size = 26
launcher_icon_asb = 100 0 0
launcher_icon_theme_override = 0
startup_notifications = 1
launcher_tooltip = 1
launcher_item_app = kolinos-terminal.desktop
launcher_item_app = pcmanfm.desktop

#-------------------------------------
# Clock
time1_format = %H:%M
time2_format = %a %d %b
time1_timezone =
time2_timezone =
clock_font_color = #f5f3ff 95
clock_padding = 10 2
clock_background_id = 0
clock_tooltip = KolinOS Corvo Glass
clock_tooltip_timezone =
clock_lclick_command =
clock_rclick_command =
clock_mclick_command =
clock_uwheel_command =
clock_dwheel_command =

#-------------------------------------
# Battery
battery_tooltip = 1
battery_low_status = 20
battery_low_cmd = notify-send "KolinOS" "Bateria fraca"
battery_full_cmd =
battery_font_color = #f5f3ff 95
bat1_format = %p
bat2_format = %t
battery_padding = 6 2
battery_background_id = 0
battery_hide = 101
battery_lclick_command =
battery_rclick_command =
battery_mclick_command =
battery_uwheel_command =
battery_dwheel_command =
ac_connected_cmd =
ac_disconnected_cmd =

#-------------------------------------
# Tooltip
tooltip_show_timeout = 0.4
tooltip_hide_timeout = 0.2
tooltip_padding = 8 6
tooltip_background_id = 5
tooltip_font_color = #f5f3ff 95

