# KolinOS "Corvo Glass" — openbox theme (FASE 7)
# A flat, dark title bar with a thin accent border, so it reads as a glass slab
# floating over the wallpaper (blur/rounding is done by picom).
# Install path: /usr/share/themes/CorvoGlass/openbox-3/themerc

border.width: 1
padding.width: 4
padding.height: 4
window.handle.width: 0
window.client.padding.width: 0
menu.overlap: 0

# --- active window ---------------------------------------------------------
window.active.title.bg: Flat Solid
window.active.title.bg.color: #14102A
window.active.title.separator.color: #785AC8
window.active.label.text.color: #F5F3FF
window.active.handle.bg: Flat Solid
window.active.handle.bg.color: #14102A
window.active.grip.bg: Flat Solid
window.active.grip.bg.color: #14102A
window.active.border.color: #785AC8
window.active.button.unpressed.image.color: #A9A3C9
window.active.button.hover.image.color: #F5F3FF
window.active.button.pressed.image.color: #A88BFF

# --- inactive window -------------------------------------------------------
window.inactive.title.bg: Flat Solid
window.inactive.title.bg.color: #0C0A16
window.inactive.title.separator.color: #2A2440
window.inactive.label.text.color: #A9A3C9
window.inactive.handle.bg: Flat Solid
window.inactive.handle.bg.color: #0C0A16
window.inactive.grip.bg: Flat Solid
window.inactive.grip.bg.color: #0C0A16
window.inactive.border.color: #2A2440
window.inactive.button.unpressed.image.color: #6E688C

# --- title bar buttons -----------------------------------------------------
window.active.button.unpressed.bg: Flat Solid
window.active.button.unpressed.bg.color: #14102A
window.inactive.button.unpressed.bg: Flat Solid
window.inactive.button.unpressed.bg.color: #0C0A16

window.active.button.close.unpressed.image.color: #FB7185
window.active.button.max.unpressed.image.color:  #A9A3C9
window.active.button.iconify.unpressed.image.color: #A9A3C9
window.active.button.desktop.unpressed.image.color: #A9A3C9
window.active.button.shade.unpressed.image.color: #A9A3C9

# --- menus -----------------------------------------------------------------
menu.items.bg: Flat Solid
menu.items.bg.color: #14102A
menu.items.text.color: #F5F3FF
menu.items.disabled.text.color: #6E688C
menu.items.active.bg: Flat Solid
menu.items.active.bg.color: #785AC8
menu.items.active.text.color: #F5F3FF
menu.border.color: #2A2440
menu.title.bg: Flat Solid
menu.title.bg.color: #0C0A16
menu.title.text.color: #A88BFF
menu.separator.color: #2A2440
